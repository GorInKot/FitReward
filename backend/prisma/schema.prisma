generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @default(cuid())
  telegramId String  @unique
  firstName  String?
  lastName   String?
  username   String?
  isPremium  Boolean @default(false)

  // Body baseline — optional, can be filled outside onboarding
  age    Int?
  weight Float?
  height Float?

  // Onboarding answers
  primaryGoal           PrimaryGoal?
  experienceLevel       ExperienceLevel?
  trainingDaysPerWeek   Int?
  trainingEnvironment   TrainingEnvironment?
  limitations           Limitation[]

  // Derived recommendation
  recommendedStructure  TrainingStructure?

  onboardingCompletedAt DateTime?

  programs     Program[]
  sessions     WorkoutSession[]
  bodyMetrics  BodyMetric[]
  achievements UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PrimaryGoal {
  MUSCLE_GAIN
  FAT_LOSS
  GENERAL_FITNESS
  STRENGTH
  ENDURANCE
  BODY_RECOMPOSITION
  RETURN_AFTER_BREAK
}

enum ExperienceLevel {
  NEVER
  LESS_THAN_6_MONTHS
  ONE_TO_TWO_YEARS
  THREE_PLUS_YEARS
}

enum TrainingEnvironment {
  GYM
  HOME
  HOME_MINIMAL
  BODYWEIGHT
}

enum Limitation {
  NONE
  LOWER_BACK
  KNEES
  SHOULDERS
  POST_INJURY
}

enum TrainingStructure {
  FULL_BODY
  UPPER_LOWER
  PUSH_PULL_LEGS
  SPLIT
}

model ExerciseCatalog {
  id               String           @id @default(cuid())
  slug             String           @unique
  nameEn           String
  nameRu           String?
  category         MovementCategory
  primaryMuscles   MuscleGroup[]
  secondaryMuscles MuscleGroup[]
  equipment        Equipment[]
  difficulty       Difficulty       @default(BEGINNER)
  instructions     String?
  imageUrl         String?
  sourceId         String?
  source           String           @default("wger")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  programSlots     ProgramExerciseSlot[]
  sessionExercises SessionExercise[]

  @@index([category])
  @@index([source, sourceId])
}

model Program {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  structure   TrainingStructure
  status      ProgramStatus     @default(ACTIVE)
  generatedAt DateTime          @default(now())
  archivedAt  DateTime?
  days        ProgramDay[]

  @@index([userId, status])
}

enum ProgramStatus {
  ACTIVE
  ARCHIVED
}

model ProgramDay {
  id        String                @id @default(cuid())
  programId String
  program   Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  order     Int
  name      String
  exercises ProgramExerciseSlot[]
  sessions  WorkoutSession[]

  @@index([programId])
}

model ProgramExerciseSlot {
  id                String          @id @default(cuid())
  programDayId      String
  programDay        ProgramDay      @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  order             Int
  exerciseCatalogId String
  exercise          ExerciseCatalog @relation(fields: [exerciseCatalogId], references: [id])
  slotName          String
  suggestedSets     Int
  suggestedRepsLow  Int
  suggestedRepsHigh Int
  suggestedRestSec  Int

  @@index([programDayId])
}

enum MovementCategory {
  PUSH
  PULL
  LEGS
  CORE
  CARDIO
  FULL_BODY_COMPOUND
}

enum MuscleGroup {
  CHEST
  UPPER_BACK
  LATS
  LOWER_BACK
  SHOULDERS_FRONT
  SHOULDERS_SIDE
  SHOULDERS_REAR
  BICEPS
  TRICEPS
  FOREARMS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS
  OBLIQUES
}

enum Equipment {
  BARBELL
  DUMBBELL
  KETTLEBELL
  MACHINE
  CABLE
  BODYWEIGHT
  RESISTANCE_BAND
  BENCH
  PULL_UP_BAR
  GYMNASTIC_RINGS
  SWISS_BALL
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model WorkoutSession {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  programDayId     String?
  programDay       ProgramDay?       @relation(fields: [programDayId], references: [id], onDelete: SetNull)
  dayName          String
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  perceivedFatigue Int?
  notes            String?
  exercises        SessionExercise[]

  @@index([userId, completedAt])
  @@index([userId, startedAt])
}

model SessionExercise {
  id                String          @id @default(cuid())
  sessionId         String
  session           WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseCatalogId String
  exercise          ExerciseCatalog @relation(fields: [exerciseCatalogId], references: [id])
  order             Int
  slotName          String
  suggestedSets     Int
  suggestedRepsLow  Int
  suggestedRepsHigh Int
  suggestedRestSec  Int
  completedAt       DateTime?
  setLogs           SetLog[]

  @@index([sessionId])
}

model SetLog {
  id                String          @id @default(cuid())
  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  weight            Float?
  reps              Int
  rir               Int?
  completedAt       DateTime        @default(now())

  @@index([sessionExerciseId])
}

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  weight    Float?
  bodyFat   Float?
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Achievement {
  id               String              @id @default(cuid())
  key              String              @unique
  category         AchievementCategory
  threshold        Int?
  reward           Int                 @default(10)
  userAchievements UserAchievement[]
}

enum AchievementCategory {
  CONSISTENCY
  MILESTONE
  STRENGTH
  BODY
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())
  notifiedAt    DateTime?

  @@unique([userId, achievementId])
  @@index([userId])
}

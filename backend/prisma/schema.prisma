generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @default(cuid())
  telegramId String  @unique
  firstName  String?
  lastName   String?
  username   String?
  isPremium  Boolean @default(false)

  // Body baseline — optional, can be filled outside onboarding
  age    Int?
  weight Float?
  height Float?

  // Onboarding answers
  primaryGoal           PrimaryGoal?
  experienceLevel       ExperienceLevel?
  trainingDaysPerWeek   Int?
  trainingEnvironment   TrainingEnvironment?
  limitations           Limitation[]

  // Derived recommendation
  recommendedStructure  TrainingStructure?
  recommendationReasons String[]

  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PrimaryGoal {
  MUSCLE_GAIN
  FAT_LOSS
  GENERAL_FITNESS
  STRENGTH
  ENDURANCE
  BODY_RECOMPOSITION
  RETURN_AFTER_BREAK
}

enum ExperienceLevel {
  NEVER
  LESS_THAN_6_MONTHS
  ONE_TO_TWO_YEARS
  THREE_PLUS_YEARS
}

enum TrainingEnvironment {
  GYM
  HOME
  HOME_MINIMAL
  BODYWEIGHT
}

enum Limitation {
  NONE
  LOWER_BACK
  KNEES
  SHOULDERS
  POST_INJURY
}

enum TrainingStructure {
  FULL_BODY
  UPPER_LOWER
  PUSH_PULL_LEGS
  SPLIT
}
